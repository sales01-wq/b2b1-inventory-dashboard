{
  "name": "inventory-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && VITE_DEMO_DATA=1 vite build --outDir dist-demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/upload.mjs",
    "e2e:features": "npm run build:demo && node e2e/features.mjs",
    "e2e:production": "npm run build && node e2e/production.mjs",
    "e2e:preview": "npm run build:demo && node e2e/preview.mjs",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.13",
    "@astryxdesign/theme-neutral": "0.7.13",
    "@heroicons/react": "2.2.0",
    "@stylexjs/stylex": "0.19.1",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "26.1.0",
    "papaparse": "5.4.1",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "5.1.0"
  }
}
